{
  "name": "devutils-npm",
  "version": "1.0.0",
  "description": "A lightweight JavaScript utility toolkit for strings, arrays, validation, objects, numbers, and dates.",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./strings": "./src/strings.js",
    "./arrays": "./src/arrays.js",
    "./validation": "./src/validation.js",
    "./objects": "./src/objects.js",
    "./numbers": "./src/numbers.js",
    "./dates": "./src/dates.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "npm test && npm pack --dry-run"
  },
  "keywords": [
    "utilities",
    "devtools",
    "javascript",
    "string",
    "array",
    "validation",
    "date",
    "node"
  ],
  "author": "Vanshika",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanshika252007/asd-npm.git"
  },
  "bugs": {
    "url": "https://github.com/vanshika252007/asd-npm/issues"
  },
  "homepage": "https://github.com/vanshika252007/asd-npm#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ]
}
